+// UE4M3 scale for NVFP4 (unsigned, 4 exp bits bias=7, 3 mantissa bits)
+// Returns the raw scale value (cf. ggml_ue4m3_to_fp32 which returns raw*0.5).
+// kvalues_mxfp4_f holds true E2M1 values, so d_raw * k_true is correct.
+static inline float ue4m3_to_fp32(uint8_t x) {
+    if (x == 0 || x == 0x7F) {
+        return 0.0f;
+    }
+    const uint exp = (x >> 3) & 0xF;
+    const uint man = x & 0x7;
+    if (exp == 0) {
+        return (float) man * (1.0f / 512.0f);
+    }
+    const uint bits = ((exp + 120) << 23) | (man << 20);
+    return as_type<float>(bits);
+}
