+// NVFP4: QK=64, 4x UE4M3 scales (one per 16 elems) + 32B packed E2M1.
+// Within each 16-elem sub-block: qs bytes [s*8, s*8+8), low nibbles = elems 0..7,
+// high nibbles = elems 8..15 (matches dequantize_row_nvfp4 in ggml-quants.c).
+// Generic kernels call with il = sub-block index 0..3 (nl = 4 = QK/16).
+template <typename type4x4>
+void dequantize_nvfp4(device const block_nvfp4 * xb, short il, thread type4x4 & reg) {
+    const float d = ue4m3_to_fp32(xb->d[il]);
+    device const uint8_t * qs = xb->qs + il*8;
+
+    reg[0][0] = d * kvalues_mxfp4_f[ qs[0] & 0x0F];
+    reg[0][1] = d * kvalues_mxfp4_f[ qs[1] & 0x0F];
+    reg[0][2] = d * kvalues_mxfp4_f[ qs[2] & 0x0F];
+    reg[0][3] = d * kvalues_mxfp4_f[ qs[3] & 0x0F];
+    reg[1][0] = d * kvalues_mxfp4_f[ qs[4] & 0x0F];
+    reg[1][1] = d * kvalues_mxfp4_f[ qs[5] & 0x0F];
+    reg[1][2] = d * kvalues_mxfp4_f[ qs[6] & 0x0F];
+    reg[1][3] = d * kvalues_mxfp4_f[ qs[7] & 0x0F];
+    reg[2][0] = d * kvalues_mxfp4_f[(qs[0] >> 4) & 0x0F];
+    reg[2][1] = d * kvalues_mxfp4_f[(qs[1] >> 4) & 0x0F];
+    reg[2][2] = d * kvalues_mxfp4_f[(qs[2] >> 4) & 0x0F];
+    reg[2][3] = d * kvalues_mxfp4_f[(qs[3] >> 4) & 0x0F];
+    reg[3][0] = d * kvalues_mxfp4_f[(qs[4] >> 4) & 0x0F];
+    reg[3][1] = d * kvalues_mxfp4_f[(qs[5] >> 4) & 0x0F];
+    reg[3][2] = d * kvalues_mxfp4_f[(qs[6] >> 4) & 0x0F];
+    reg[3][3] = d * kvalues_mxfp4_f[(qs[7] >> 4) & 0x0F];
+}
+
+template <typename type4>
+void dequantize_nvfp4_t4(device const block_nvfp4 * xb, short il, thread type4 & reg) {
+    const short sub = il/4;
+    const short k = il%4;
+    const float d = ue4m3_to_fp32(xb->d[sub]);
+    device const uint8_t * qs = xb->qs + sub*8 + (k%2)*4;
+    const uint8_t shr = k < 2 ? 0 : 4;
+
+    reg[0] = d * kvalues_mxfp4_f[(qs[0] >> shr) & 0x0F];
+    reg[1] = d * kvalues_mxfp4_f[(qs[1] >> shr) & 0x0F];
+    reg[2] = d * kvalues_mxfp4_f[(qs[2] >> shr) & 0x0F];
+    reg[3] = d * kvalues_mxfp4_f[(qs[3] >> shr) & 0x0F];
+}
